async function eliminarPost() {
  try {
    const response = await fetch(
      'https://jsonplaceholder.typicode.com/posts/1',
      {
        method: 'DELETE'
      }
    );

    if (response.ok) {
      console.log('Eliminado exitosamente');
    }

  } catch (error) {
    console.error('Error:', error);
  }
}

eliminarPost();
