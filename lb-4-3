async function verificarEstado() {

  const response = await fetch("https://jsonplaceholder.typicode.com/posts/1");

  // Verificar estado
  if (response.ok) {

    console.log("Éxito: " + response.status);

  } else {

    console.log("Error: " + response.status);

  }

  // Convertir a JSON
  const data = await response.json();

  console.log(data);

}

verificarEstado();
