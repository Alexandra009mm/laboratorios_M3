async function postsPorUsuario() {
  // Fetch + filter
  try{
  const response = await fetch('https://jsonplaceholder.typicode.com/posts')
    if(response){
      const data = await response.json()
      const newArray = data.filter(posts => posts.userId === 1)
      console.log('cantidad de post del usuario 1' + newArray.length)
    }
  }catch(error){
    console.error('ha ocurriodo un error', error)
  }
}

postsPorUsuario();
